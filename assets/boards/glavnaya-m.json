 24\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"/><path d=\"M10 14 21 3\"/><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/></svg><span>Открыть как клиент</span></button>\n  </div>\n</section>\n<div class=\"panel panel--tint panel--s panel--row guardline\">\n  <span class=\"panel__i\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/></svg></span>\n  <div class=\"guardline__c\"><div class=\"guardline__r\"><p><b>Ваши клиенты под защитой.</b> <sc-if value=\"{{notWhy}}\" hint-placeholder-val=\"{{ true }}\"><span>Они закреплены за Вами.</span></sc-if></p><button type=\"button\" class=\"btn btn--quiet btn--s\" aria-expanded=\"{{whyExp}}\" onClick=\"{{toggleWhy}}\"><span>{{whyBtn}}</span></button></div><sc-if value=\"{{why}}\" hint-placeholder-val=\"{{ false }}\"><p class=\"guardline__more\">Клиент, которого Вы передали или который пришёл по Вашей ссылке, закрепляется за Вами. Срок закрепления виден в карточке клиента.</p></sc-if></div>\n</div>\n</div>\n</main>\n<sc-if value=\"{{qr}}\" hint-placeholder-val=\"{{ false }}\"><div class=\"hb-kab-ovl\" data-scrim><div class=\"modal modal--pad modal--s\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"qr-h\"><div class=\"mn-modal__h\"><h2 class=\"h4\" id=\"qr-h\">QR-код Вашей ссылки</h2><button type=\"button\" class=\"btn btn--icon btn--quiet\" aria-label=\"Закрыть\" onClick=\"{{closeQr}}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button></div><svg class=\"mn-qr\" viewBox=\"0 0 21 21\" role=\"img\" aria-label=\"QR-код личной ссылки (макет)\" shape-rendering=\"crispEdges\"><g fill=\"currentColor\"><path d=\"M0 0h7v7H0zM14 0h7v7h-7zM0 14h7v7H0z\"/><path fill=\"#fff\" d=\"M1 1h5v5H1zM15 1h5v5h-5zM1 15h5v5H1z\"/><path d=\"M2 2h3v3H2zM16 2h3v3h-3zM2 16h3v3H2z\"/><path d=\"M8 0h2v2H8zM11 1h2v2h-2zM8 4h1v3H8zM10 5h3v2h-3zM0 8h2v2H0zM3 8h3v1H3zM8 8h2v2H8zM11 8h2v1h-2zM14 8h2v2h-2zM17 9h4v2h-4zM0 11h1v2H0zM2 11h3v2H2zM6 10h2v3H6zM9 11h3v2H9zM13 11h2v1h-2zM16 12h2v2h-2zM19 13h2v2h-2zM8 14h2v2H8zM11 14h2v3h-2zM14 15h2v2h-2zM17 16h1v3h-1zM8 17h2v2H8zM12 18h3v2h-3zM16 19h2v2h-2zM19 17h2v1h-2zM9 20h2v1H9z\"/></g></svg><p class=\"note\">Клиент наводит камеру телефона на код и попадает на Вашу ссылку.</p><div class=\"mn-btnrow\"><button type=\"button\" class=\"btn btn--acc\" onClick=\"{{saveQr}}\"><span>Сохранить картинку</span></button><button type=\"button\" class=\"btn btn--quiet\" onClick=\"{{closeQr}}\"><span>Закрыть</span></button></div></div></div></sc-if>\n<sc-if value=\"{{share}}\" hint-placeholder-val=\"{{ false }}\"><div class=\"hb-kab-ovl\" data-scrim><div class=\"modal modal--pad modal--s\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sh-h\"><div class=\"mn-modal__h\"><h2 class=\"h4\" id=\"sh-h\">Поделиться ссылкой</h2><button type=\"button\" class=\"btn btn--icon btn--quiet\" aria-label=\"Закрыть\" onClick=\"{{closeShare}}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button></div><svg class=\"mn-qr\" viewBox=\"0 0 21 21\" role=\"img\" aria-label=\"QR-код ссылки-приглашения (макет)\" shape-rendering=\"crispEdges\"><g fill=\"currentColor\"><path d=\"M0 0h7v7H0zM14 0h7v7h-7zM0 14h7v7H0z\"/><path fill=\"#fff\" d=\"M1 1h5v5H1zM15 1h5v5h-5zM1 15h5v5H1z\"/><path d=\"M2 2h3v3H2zM16 2h3v3h-3zM2 16h3v3H2z\"/><path d=\"M8 0h2v2H8zM11 1h2v2h-2zM8 4h1v3H8zM10 5h3v2h-3zM0 8h2v2H0zM3 8h3v1H3zM8 8h2v2H8zM11 8h2v1h-2zM14 8h2v2h-2zM17 9h4v2h-4zM0 11h1v2H0zM2 11h3v2H2zM6 10h2v3H6zM9 11h3v2H9zM13 11h2v1h-2zM16 12h2v2h-2zM19 13h2v2h-2zM8 14h2v2H8zM11 14h2v3h-2zM14 15h2v2h-2zM17 16h1v3h-1zM8 17h2v2H8zM12 18h3v2h-3zM16 19h2v2h-2zM19 17h2v1h-2zM9 20h2v1H9z\"/></g></svg><p class=\"note\">Агент наводит камеру телефона на код и попадает на страницу приглашения в Вашу сеть.</p><div class=\"copy\"><input class=\"input\" type=\"text\" readonly value=\"housebook.global/ru?inv=PRG7K2\" aria-label=\"Ссылка-приглашение\"><button type=\"button\" class=\"btn\" aria-live=\"polite\" onClick=\"{{copyShare}}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\"/><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"/></svg><span>Копировать</span></button></div><div class=\"mn-btnrow\"><button type=\"button\" class=\"btn btn--acc\" onClick=\"{{saveShare}}\"><span>Сохранить картинку</span></button><button type=\"button\" class=\"btn btn--quiet\" onClick=\"{{closeShare}}\"><span>Закрыть</span></button></div></div></div></sc-if>\n<sc-if value=\"{{hasToast}}\" hint-placeholder-val=\"{{ false }}\"><div class=\"toasts\"><div class=\"toast toast--ok\" role=\"status\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"toast__t\">{{toast}}</span></div></div></sc-if>\n<dc-import name=\"Nav\" part=\"bar\" current=\"glavnaya\" suffix=\"-m\" hint-size=\"100%,64px\"></dc-import>\n<dc-import name=\"Nav\" part=\"fab\" current=\"glavnaya\" suffix=\"-m\" hint-size=\"1px,1px\"></dc-import>\n<dc-import name=\"Nav\" part=\"cpanel\" current=\"glavnaya\" suffix=\"-m\" hint-size=\"1px,1px\"></dc-import>\n</div>\n</div>","script":"\nclass Component extends DCLogic {\n  constructor(props) {\n    super(props);\n    this.state = { help: false, share: false, qr: false, why: false, toast: '', learn: true };\n  }\n  renderVals() {\n    const S = this.state, set = (o) => this.setState(o);\n    const toast = (t) => { set({ toast: t }); clearTimeout(this._t); this._t = setTimeout(() => set({ toast: '' }), 3200); };\n    return {\n      help: S.help, toggleHelp: () => set({ help: !S.help }),\n      share: S.share, openShare: () => set({ share: true }), closeShare: () => set({ share: false }), copyShare: () => toast('Ссылка для приглашения скопирована'), saveShare: () => { set({ share: false }); toast('Картинка сохранена в загрузки'); },\n      qr: S.qr, openQr: () => set({ qr: true }), closeQr: () => set({ qr: false }), saveQr: () => { set({ qr: false }); toast('Картинка сохранена в загрузки'); },\n      why: S.why, notWhy: !S.why, whyExp: S.why ? 'true' : 'false', whyBtn: S.why ? 'Свернуть' : 'Как это работает', toggleWhy: () => set({ why: !S.why }),\n      copyLink: () => toast('Ссылка скопирована'),\n      shareWa: () => toast('В кабинете откроется WhatsApp со ссылкой'),\n      shareTg: () => toast('В кабинете откроется Telegram со ссылкой'),\n      shareMl: () => toast('В кабинете откроется письмо со ссылкой'),\n      asClient: () => toast('В кабинете откроется страница так, как её увидит клиент'),\n      learn: S.learn, notLearn: !S.learn, hide: () => set({ learn: false }), show: () => set({ learn: true }),\n      hasToast: !!S.toast, toast: S.toast\n    };\n  }\n}\n\nComponent = (function (Base) { return class extends Base {\n  constructor(props) { super(props);  }\n  renderVals() { const v = super.renderVals(); const S = this.state, set = (o) => this.setState(o); v.evNew = HB.events(); v.pulse = HB.net.pulse(); return v; }\n}; })(Component);\n"}