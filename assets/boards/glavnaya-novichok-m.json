den=\"true\"><path d=\"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z\"/><path d=\"M22 10v6\"/><path d=\"M6 12.5V16a6 3 0 0 0 12 0v-3.5\"/></svg></span><p><b>Начало работы скрыто</b> · {{ cntT }}</p><button type=\"button\" class=\"btn btn--s btn--quiet\" onClick=\"{{ show }}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg><span>Показать снова</span></button></div></sc-if>\n<section class=\"stack\" aria-labelledby=\"h-s\"><h2 class=\"h4\" id=\"h-s\">Ваши деньги</h2><div class=\"sstrip sstrip--3 sstrip--lg\" role=\"group\" aria-label=\"Деньги по трём состояниям\"><div><b>0</b><span>Начислено</span><small>AED</small></div><div><b>0</b><span>Ожидается к выплате</span><small>AED</small></div><div><b>0</b><span>Выплачено</span><small>AED</small></div></div><p class=\"fresh\">Суммы появятся после первой сделки · <a class=\"more\" href=\"dengi-m.dc.html\"><span>Как считаются деньги</span><svg class=\"ic ic--16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a></p></section>\n<div class=\"hgrid\">\n<section class=\"panel hcard\" aria-labelledby=\"h-fn\"><div class=\"hcard__h\"><h2 class=\"h4\" id=\"h-fn\">Воронка клиентов<span class=\"newtag\">Новое</span></h2><p class=\"hcard__s\">за всё время</p></div><div class=\"hcard__b\"><ul class=\"fnl\"><sc-for list=\"{{ stages }}\" as=\"f\" hint-placeholder-count=\"6\"><li><a class=\"fnr\" href=\"{{ f.href }}\"><span class=\"lrow__b\"><b>{{ f.n }}</b><span class=\"progress\" style=\"--hb-v:{{ f.pct }}%\" role=\"img\" aria-label=\"{{ f.aria }}\"><i></i></span></span><span class=\"lrow__m\"><b>{{ f.c }}</b></span></a></li></sc-for></ul></div><div class=\"hcard__f\"><div><span>Конверсия</span><b>{{ conv }}</b></div><div><span>Подборки</span><b>0</b></div><div><span>Просмотры</span><b>0</b></div></div></section>\n<section class=\"panel hcard\" aria-labelledby=\"h-mc\"><div class=\"hcard__h\"><h2 class=\"h4\" id=\"h-mc\">Клиенты по месяцам<span class=\"newtag\">Новое</span></h2><div class=\"seg\" role=\"group\" aria-label=\"Период\"><button type=\"button\" aria-pressed=\"{{ on6 }}\" onClick=\"{{ pick6 }}\">6&nbsp;месяцев</button><button type=\"button\" aria-pressed=\"{{ on12 }}\" onClick=\"{{ pick12 }}\">12&nbsp;месяцев</button></div></div><div class=\"hcard__b\"><dl class=\"mc__sum\"><div><dt><span class=\"mc__dot\" aria-hidden=\"true\"></span>Переданы</dt><dd>{{ sumT }}</dd></div><div><dt><span class=\"mc__dot is-2\" aria-hidden=\"true\"></span>Взяты в работу</dt><dd>{{ sumW }}</dd></div><div><dt>В среднем за месяц</dt><dd>{{ avgT }}</dd></div></dl><div class=\"mc {{ mcCls }}\"><div class=\"mc__y\" aria-hidden=\"true\"><span>0</span><span>1</span><span>2</span></div><div class=\"mc__plot\" style=\"{{ plotStyle }}\" role=\"list\" aria-label=\"Клиенты по месяцам: переданы и взяты в работу\"><sc-for list=\"{{ bars }}\" as=\"c\" hint-placeholder-count=\"12\"><div class=\"mc__c\" role=\"listitem\" tabindex=\"0\" aria-label=\"{{ c.label }}\"><span class=\"mc__b\" style=\"{{ c.sT }}\"></span><span class=\"mc__b is-2\" style=\"{{ c.sW }}\"></span><span class=\"mc__tip\" role=\"tooltip\"><b>{{ c.full }}</b><span>Переданы: {{ c.t }}</span><span>Взяты в работу: {{ c.w }}</span></span></div></sc-for></div><div class=\"mc__x\" style=\"{{ plotStyle }}\" aria-hidden=\"true\"><sc-for list=\"{{ bars }}\" as=\"c\" hint-placeholder-count=\"12\"><span>{{ c.m }}</span></sc-for></div><sc-if value=\"{{ noData }}\" hint-placeholder-val=\"{{ true }}\"><p class=\"mc__empty\">Здесь появятся Ваши клиенты по месяцам</p></sc-if></div></div></section>\n<section class=\"panel hcard\" aria-labelledby=\"h-net\"><div class=\"hcard__h\"><h2 class=\"h4\" id=\"h-net\">Моя сеть<span class=\"newtag\">Новое</span></h2></div><div class=\"hcard__b\"><div><a class=\"nrow\" href=\"dengi-m.dc.html\"><span>Доход с сети: ожидается</span><span>0 AED<svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></span></a><a class=\"nrow\" href=\"dengi-m.dc.html\"><span>Доход с сети: выплачено</span><span>0 AED<svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"/></svg></span></a></div><sc-if value=\"{{ netNo }}\" hint-placeholder-val=\"{{ true }}\"><p class=\"npulse\">В сети пока никого. Пригласите коллегу: часть дохода с его заявок будет идти Вам.</p></sc-if><sc-if value=\"{{ netYes }}\" hint-placeholder-val=\"{{ false }}\"><p class=\"npulse\"><b>{{ netText }}</b></p><p class=\"note\">{{ netNames }}</p></sc-if><div class=\"mn-btnrow\"><a class=\"btn\" href=\"moya-set-m.dc.html\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><line x1=\"19\" x2=\"19\" y1=\"8\" y2=\"14\"/><line x1=\"22\" x2=\"16\" y1=\"11\" y2=\"11\"/></svg><span>Пригласить&nbsp;коллегу</span></a></div></div></section>\n<section class=\"panel hcard\" aria-labelledby=\"h-ev\"><div class=\"hcard__h\"><h2 class=\"h4\" id=\"h-ev\">Последние события<span class=\"newtag\">Новое</span></h2></div><div class=\"hcard__b\"><sc-if value=\"{{ evEmpty }}\" hint-placeholder-val=\"{{ true }}\"><div class=\"hempty\" role=\"status\"><p>Событий пока нет. Передайте первого клиента, и здесь появится первое событие.</p><a class=\"btn\" href=\"klienty-forma-m.dc.html\"><span>Передать клиента</span></a></div></sc-if><sc-if value=\"{{ hasEv }}\" hint-placeholder-val=\"{{ false }}\"><section class=\"tline tline--lg\" aria-label=\"Последние события\"><div class=\"tline__day\"><p class=\"tline__d\">Сегодня</p><ul class=\"tline__evs\"><sc-for list=\"{{ ev }}\" as=\"e\" hint-placeholder-count=\"1\"><li class=\"tev tev--sys\"><span class=\"tev__i\" aria-hidden=\"true\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg></span><div class=\"tev__c\"><div class=\"tev__h\"><a href=\"{{ e.href }}\" data-client=\"{{ e.cid }}\"><b>{{ e.t }}</b></a><time>{{ e.time }}</time></div><p class=\"tev__s\">{{ e.s }}</p></div></li></sc-for></ul></div></section></sc-if></div></section>\n<section class=\"panel hcard\" aria-labelledby=\"h-ms\"><div class=\"hcard__h\"><h2 class=\"h4\" id=\"h-ms\">Ближайшая веха<span class=\"newtag\">Новое</span></h2></div><div class=\"hcard__b\"><p><b>Первая закрытая заявка: 0 из 1</b></p><div class=\"progress\" style=\"--hb-v:0%\" role=\"img\" aria-label=\"Выполнено 0 из 1\"><i></i></div><p class=\"note\">Закройте первую заявку, и Ваша активность продлится ещё на полгода.</p><a class=\"more\" href=\"moya-set-m.dc.html\"><span>Как работает активность</span><svg class=\"ic ic--16\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"m12 5 7 7-7 7\"/></svg></a></div></section>\n<section class=\"panel hcard linkbar\" aria-labelledby=\"h-l\"><div class=\"hcard__h\"><h2 class=\"h4\" id=\"h-l\">Ваша личная ссылка</h2></div><div class=\"hcard__b\">\n  <p class=\"note\">Клиент, который придёт по ссылке, закрепится за Вами.</p>\n  <div class=\"linkbar__row\">\n    <div class=\"copy\"><input class=\"input\" id=\"lk\" type=\"text\" readonly value=\"housebook.global/ru?cl=PRG7K2\" aria-label=\"Личная ссылка\"><button type=\"button\" class=\"btn\" aria-live=\"polite\" onClick=\"{{copyLink}}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect width=\"14\" height=\"14\" x=\"8\" y=\"8\" rx=\"2\" ry=\"2\"/><path d=\"M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2\"/></svg><span>Копировать</span></button></div>\n    <div class=\"linkbar__share\" role=\"group\" aria-label=\"Отправить ссылку\">\n      <button type=\"button\" class=\"btn btn--icon\" aria-label=\"Отправить в WhatsApp\" onClick=\"{{shareWa}}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"none\" aria-hidden=\"true\"><path d=\"M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.945C.16 5.335 5.495 0 12.05 0a11.817 11.817 0 018.413 3.488 11.824 11.824 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.978-1.607zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z\"/></svg></button>\n      <button type=\"button\" class=\"btn btn--icon\" aria-label=\"Отправить в Telegram\" onClick=\"{{shareTg}}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg></button>\n      <button type=\"button\" class=\"btn btn--icon\" aria-label=\"Отправить по почте\" onClick=\"{{shareMl}}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect width=\"20\" height=\"16\" x=\"2\" y=\"4\" rx=\"2\"/><path d=\"m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7\"/></svg></button>\n      <button type=\"button\" class=\"btn btn--icon\" aria-haspopup=\"dialog\" aria-label=\"Показать QR-код\" onClick=\"{{openQr}}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect width=\"5\" height=\"5\" x=\"3\" y=\"3\" rx=\"1\"/><rect width=\"5\" height=\"5\" x=\"16\" y=\"3\" rx=\"1\"/><rect width=\"5\" height=\"5\" x=\"3\" y=\"16\" rx=\"1\"/><path d=\"M21 16h-3a2 2 0 0 0-2 2v3\"/><path d=\"M21 21v.01\"/><path d=\"M12 7v3a2 2 0 0 1-2 2H7\"/><path d=\"M3 12h.01\"/><path d=\"M12 3h.01\"/><path d=\"M12 16v.01\"/><path d=\"M16 12h1\"/><path d=\"M21 12v.01\"/><path d=\"M12 21v-1\"/></svg></button>\n    </div>\n    <button type=\"button\" class=\"btn btn--quiet\" onClick=\"{{asClient}}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 3h6v6\"/><path d=\"M10 14 21 3\"/><path d=\"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6\"/></svg><span>Открыть как клиент</span></button>\n  </div>\n</div></section>\n</div>\n<div class=\"panel panel--tint panel--s panel--row guardline\">\n  <span class=\"panel__i\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/></svg></span>\n  <div class=\"guardline__c\"><div class=\"guardline__r\"><p><b>Ваши клиенты под защитой.</b> <sc-if value=\"{{notWhy}}\" hint-placeholder-val=\"{{ true }}\"><span>Они закреплены за Вами.</span></sc-if></p><button type=\"button\" class=\"btn btn--quiet btn--s\" aria-expanded=\"{{whyExp}}\" onClick=\"{{toggleWhy}}\"><span>{{whyBtn}}</span></button></div><sc-if value=\"{{why}}\" hint-placeholder-val=\"{{ false }}\"><p class=\"guardline__more\">Клиент, которого Вы передали или который пришёл по Вашей ссылке, закрепляется за Вами. Срок закрепления виден в карточке клиента.</p></sc-if></div>\n</div>\n</div>\n</main>\n<sc-if value=\"{{ vOn }}\" hint-placeholder-val=\"{{ false }}\"><div class=\"hb-kab-ovl\" onClick=\"{{ vScrim }}\" onKeyDown=\"{{ vKey }}\"><div class=\"modal modal--pad\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"nv-t\" onClick=\"{{ vStop }}\"><div class=\"nv-head\"><h2 class=\"h4\" id=\"nv-t\">Азбука и тур по кабинету</h2><button type=\"button\" class=\"btn btn--icon btn--quiet btn--round\" id=\"nv-x\" aria-label=\"Закрыть\" onClick=\"{{ vClose }}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button></div><div class=\"nv-player\" role=\"img\" aria-label=\"Видео-плеер (макет)\"><span class=\"nv-ring\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg></span><span class=\"nv-dur\">6 мин</span></div><p class=\"nv-meta\"><span class=\"badge badge--w badge--muted badge--txt\">Видео</span><span>Кабинет и сервис</span><span>6 мин</span></p><p>Короткий тур по кабинету: где лежат клиенты, деньги, материалы и помощь, и с чего начать в первый день.</p><div class=\"nv-prog\" role=\"group\" aria-label=\"Просмотр тура\"><div class=\"progress\" style=\"--hb-v:{{ vPctS }}%\" role=\"img\" aria-label=\"Просмотрено {{ vPctS }} процентов\"><i></i></div><p class=\"note\"><sc-if value=\"{{ vSeenNow }}\" hint-placeholder-val=\"{{ false }}\"><span>Просмотрено. Тур засчитан в «Начале работы».</span></sc-if><sc-if value=\"{{ vNotSeen }}\" hint-placeholder-val=\"{{ true }}\"><span>Нажмите «Смотреть тур» или отметьте, что уже посмотрели.</span></sc-if></p></div><div class=\"nv-foot\"><sc-if value=\"{{ vNotSeen }}\" hint-placeholder-val=\"{{ true }}\"><button type=\"button\" class=\"btn\" onClick=\"{{ vPlayBtn }}\"><span>{{ vPlayLabel }}</span></button><button type=\"button\" class=\"btn btn--acc\" onClick=\"{{ vSeen }}\"><span>Я посмотрел</span></button></sc-if><a class=\"btn btn--link\" href=\"obuchenie.dc.html\"><span>Вся библиотека</span></a></div></div></div></sc-if><sc-if value=\"{{qr}}\" hint-placeholder-val=\"{{ false }}\"><div class=\"hb-kab-ovl\" data-scrim><div class=\"modal modal--pad modal--s\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"qr-h\"><div class=\"mn-modal__h\"><h2 class=\"h4\" id=\"qr-h\">QR-код Вашей ссылки</h2><button type=\"button\" class=\"btn btn--icon btn--quiet\" aria-label=\"Закрыть\" onClick=\"{{closeQr}}\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button></div><svg class=\"mn-qr\" viewBox=\"0 0 21 21\" role=\"img\" aria-label=\"QR-код личной ссылки (макет)\" shape-rendering=\"crispEdges\"><g fill=\"currentColor\"><path d=\"M0 0h7v7H0zM14 0h7v7h-7zM0 14h7v7H0z\"/><path fill=\"#fff\" d=\"M1 1h5v5H1zM15 1h5v5h-5zM1 15h5v5H1z\"/><path d=\"M2 2h3v3H2zM16 2h3v3h-3zM2 16h3v3H2z\"/><path d=\"M8 0h2v2H8zM11 1h2v2h-2zM8 4h1v3H8zM10 5h3v2h-3zM0 8h2v2H0zM3 8h3v1H3zM8 8h2v2H8zM11 8h2v1h-2zM14 8h2v2h-2zM17 9h4v2h-4zM0 11h1v2H0zM2 11h3v2H2zM6 10h2v3H6zM9 11h3v2H9zM13 11h2v1h-2zM16 12h2v2h-2zM19 13h2v2h-2zM8 14h2v2H8zM11 14h2v3h-2zM14 15h2v2h-2zM17 16h1v3h-1zM8 17h2v2H8zM12 18h3v2h-3zM16 19h2v2h-2zM19 17h2v1h-2zM9 20h2v1H9z\"/></g></svg><p class=\"note\">Клиент наводит камеру телефона на код и попадает на Вашу ссылку.</p><div class=\"mn-btnrow\"><button type=\"button\" class=\"btn btn--acc\" onClick=\"{{saveQr}}\"><span>Сохранить картинку</span></button><button type=\"button\" class=\"btn btn--quiet\" onClick=\"{{closeQr}}\"><span>Закрыть</span></button></div></div></div></sc-if>\n<sc-if value=\"{{hasToast}}\" hint-placeholder-val=\"{{ false }}\"><div class=\"toasts\"><div class=\"toast toast--ok\" role=\"status\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"/></svg><span class=\"toast__t\">{{toast}}</span></div></div></sc-if>\n<dc-import name=\"Nav\" part=\"bar\" current=\"glavnaya\" suffix=\"-m\" hint-size=\"100%,64px\"></dc-import>\n<dc-import name=\"Nav\" part=\"fab\" current=\"glavnaya\" suffix=\"-m\" hint-size=\"1px,1px\"></dc-import>\n</div>\n</div>","script":"/* Главная нового агента: «Начало работы» из фактов store, скрытие, анимация завершения, события, тур. */\nclass Component extends DCLogic {\n  constructor(props) {\n    super(props);\n    this.state = { help: false, qr: false, why: false, toast: '', video: false, vPlay: false, vPct: 0, cel: 0, mon: 12 };\n  }\n  componentDidMount() { this.checkCeleb(); }\n  componentDidUpdate() { this.checkCeleb(); }\n  componentWillUnmount() { clearTimeout(this._t); clearInterval(this._vi); (this._cs || []).forEach(clearTimeout); }\n  /* все шаги выполнены или отмечены «Не нужно»: один раз проигрываем завершение и запоминаем, что обучение закончено */\n  checkCeleb() {\n    if (this.state.cel || HB.store.get('onb.done') || !HB.onb.allDone()) return;\n    HB.store.set('onb.done', true);\n    const reduce = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n    const at = (ms, o) => this._cs.push(setTimeout(() => this.setState(o), ms));\n    this._cs = [];\n    this.setState({ cel: reduce ? 2 : 1, video: false });\n    this._cs.push(setTimeout(() => { const bl = document.getElementById('nb-block'); if (bl && bl.scrollIntoView) bl.scrollIntoView({ block: 'center' }); }, 60));\n    if (reduce) { at(2000, { cel: 0 }); } else { at(900, { cel: 2 }); at(3000, { cel: 3 }); at(3700, { cel: 0 }); }\n  }\n  say(t) { this.setState({ toast: t }); clearTimeout(this._t); this._t = setTimeout(() => this.setState({ toast: '' }), 3200); }\n  markTour(msg) { HB.store.set('facts.tourSeen', true); this.setState({ vPlay: false, vPct: 100 }); clearInterval(this._vi); if (msg) this.say(msg); }\n  closeVideo() { clearInterval(this._vi); this.setState({ video: false, vPlay: false, vPct: HB.store.get('facts.tourSeen') ? 100 : 0 }); setTimeout(() => { const c = document.getElementById('nv-card'); if (c) c.focus(); }, 60); }\n  renderVals() {\n    const S = this.state, set = (o) => this.setState(o), store = HB.store;\n    const toast = (t) => this.say(t);\n    const seen = !!store.get('facts.tourSeen');\n    const steps = HB.onb.steps(), total = HB.onb.total, n = HB.onb.count();\n    const done = !!store.get('onb.done'), hidden = !!store.get('onb.hidden'), cel = S.cel;\n    const show = cel > 0 || (!done && !hidden);\n    const nx = steps.filter((s) => s.cur)[0] || steps[steps.length - 1];\n    const rows = steps.map((s) => ({\n      n: s.n, t: s.t, cls: (s.state === 'done' ? 'is-done' : s.state === 'skip' ? 'is-skip' : '') + (s.cur ? ' is-cur' : ''),\n      aria: s.cur ? 'step' : 'false', isDone: s.state === 'done', isSkip: s.state === 'skip', isNum: s.state === 'todo',\n      link: !!s.href && s.state === 'todo', tour: s.act === 'tour' && s.state === 'todo', plain: s.state !== 'todo' || (!s.href && s.act !== 'tour'), href: s.href || '',\n      cur: !!s.cur && s.state === 'todo', tag: s.req ? '' : (s.state === 'skip' ? 'отмечено «Не нужно»' : 'необязательно'), hasTag: !s.req,\n      isTg: s.id === 'telegram' && s.state === 'todo', canSkip: !s.req && s.state === 'todo', skipLabel: 'Не нужно: ' + s.t.charAt(0).toLowerCase() + s.t.slice(1),\n      skip: () => { const k = Object.assign({}, store.get('onb.skipped')); k[s.skip] = true; store.set('onb.skipped', k); set({}); },\n      canBack: s.state === 'skip', backLabel: 'Вернуть шаг: ' + s.t.charAt(0).toLowerCase() + s.t.slice(1),\n      back: () => { const k = Object.assign({}, store.get('onb.skipped')); k[s.skip] = false; store.set('onb.skipped', k); set({}); }\n    }));\n    const next = { t: nx.t, d: nx.d || '', btn: nx.btn || '', href: nx.href || '', chips: (nx.chips || []).map((t) => ({ t })), hasChips: !!(nx.chips && nx.chips.length), isLink: !!nx.href, isTour: nx.act === 'tour', label: n >= total ? 'Всё готово' : 'Следующий шаг',\n      icUser: nx.ic === 'user', icFile: nx.ic === 'file', icSend: nx.ic === 'send', icPlay: nx.ic === 'play', icUsers: nx.ic === 'users' };\n    const ev = HB.events();\n    const invd = store.get('facts.invited') || [];\n    const nI = invd.length;\n    const netText = nI === 1 ? '1 приглашён, ещё не зашёл' : nI + ' приглашены, ещё не зашли';\n    const netNames = 'Вы пригласили: ' + invd.map((x) => x.name).join(', ') + '.';\n    /* клиенты по месяцам и воронка из переданных клиентов: передача идёт в текущий месяц, взятие в работу в прототипе не моделируется */\n    const given = HB.clientsAll().length;\n    const MN = [['Дек', 'Декабрь 2025'], ['Янв', 'Январь 2026'], ['Фев', 'Февраль 2026'], ['Мар', 'Март 2026'], ['Апр', 'Апрель 2026'], ['Май', 'Май 2026'], ['Июн', 'Июнь 2026'], ['Июл', 'Июль 2026'], ['Авг', 'Август 2026'], ['Сен', 'Сентябрь 2026'], ['Окт', 'Октябрь 2026'], ['Ноя', 'Ноябрь 2026']];\n    const M = MN.map((m, i) => [m[0], m[1], i === 11 ? given : 0, 0]);\n    const nM = S.mon, rM = M.slice(12 - nM), sT = rM.reduce((a, x) => a + x[2], 0), avgM = Math.round(sT / nM * 10) / 10;\n    const mx = Math.max(2, given);\n    const L = [['all', 'Переданы', given], ['con', 'Связались', 0], ['wrk', 'Подбор', 0], ['hot', 'Готовы к покупке', 0], ['bkd', 'Депозит', 0], ['sold', 'Сделка', 0]];\n    const gone = (e) => { if (e && e.key === 'Escape') this.closeVideo(); };\n    return {\n      openTg: () => toast('Откроется Telegram с ботом Housebook. Подключение настраивается в профиле.'),\n      help: S.help, toggleHelp: () => set({ help: !S.help }),\n      qr: S.qr, openQr: () => set({ qr: true }), closeQr: () => set({ qr: false }), saveQr: () => { set({ qr: false }); toast('Картинка сохранена в загрузки'); },\n      why: S.why, notWhy: !S.why, whyExp: S.why ? 'true' : 'false', whyBtn: S.why ? 'Свернуть' : 'Как это работает', toggleWhy: () => set({ why: !S.why }),\n      copyLink: () => toast('Ссылка скопирована'),\n      shareWa: () => toast('В кабинете откроется WhatsApp со ссылкой'),\n      shareTg: () => toast('В кабинете откроется Telegram со ссылкой'),\n      shareMl: () => toast('В кабинете откроется письмо со ссылкой'),\n      asClient: () => toast('В кабинете откроется страница так, как её увидит клиент'),\n      vOn: S.video, openVideo: () => { set({ video: true, vPct: seen ? 100 : S.vPct }); setTimeout(() => { const x = document.getElementById('nv-x'); if (x) x.focus(); }, 60); },\n      vClose: () => this.closeVideo(), vScrim: () => this.closeVideo(), vStop: (e) => { e.stopPropagation(); }, vKey: gone,\n      vPlayBtn: () => {\n        if (S.vPlay || seen) return;\n        set({ vPlay: true, vPct: 0 });\n        clearInterval(this._vi);\n        this._vi = setInterval(() => { const p = Math.min(100, this.state.vPct + 10); if (p >= 100) { this.markTour('Тур просмотрен до конца'); } else this.setState({ vPct: p }); }, 350);\n      },\n      vSeen: () => { this.markTour('Тур отмечен как просмотренный'); },\n      vPlaying: S.vPlay, vPctS: seen ? 100 : S.vPct, vSeenNow: seen, vNotSeen: !seen, vPlayLabel: S.vPlay ? 'Идёт показ…' : 'Смотреть тур',\n      learn: show, notLearn: !show,\n      showStrip: !done && hidden && cel === 0,\n      hide: () => { store.set('onb.hidden', true); toast('Начало работы скрыто. Вернуть можно кнопкой «Показать снова» на этой странице'); },\n      show: () => { store.set('onb.hidden', false); set({}); },\n      cntT: n + ' из ' + total, pctS: Math.round(n / total * 1000) / 10, aboutN: 'Выполнено ' + n + ' из ' + total,\n      netNo: nI === 0, netYes: nI > 0, netText, netNames,\n      on6: S.mon === 6, on12: S.mon === 12, pick6: () => set({ mon: 6 }), pick12: () => set({ mon: 12 }),\n      sumT: sT, sumW: 0, avgT: String(avgM).replace('.', ','), mcCls: 'mc--' + nM, plotStyle: '--n:' + nM, noData: given === 0,\n      bars: rM.map((x) => ({ m: x[0], full: x[1], t: x[2], w: x[3], sT: 'height:' + x[2] / mx * 100 + '%', sW: 'height:' + x[3] / mx * 100 + '%', label: x[1] + ': переданы ' + x[2] + ', взяты в работу ' + x[3] })),\n      stages: L.map(([k, nm, c]) => ({ href: 'klienty.dc.html?stage=' + k, n: nm, c: c, pct: given ? (c / given * 100).toFixed(1) : '0', aria: nm + ': ' + c + (given ? ' из ' + given : '') })),\n      conv: '0%', evEmpty: ev.length === 0,\n      rows, next, hasEv: ev.length > 0, ev,\n      celOn: cel > 0, celCls: 'nb__cel--' + cel, blockCls: cel === 3 ? 'nb--out' : '', blockAria: cel > 0 ? 'true' : 'false',\n      hasToast: !!S.toast, toast: S.toast\n    };\n  }\n}\n"}