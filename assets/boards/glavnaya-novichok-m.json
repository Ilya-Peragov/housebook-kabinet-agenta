{"css":[],"helmet":"","tpl":"<div class=\"hb\">\n<div class=\"kab\" id=\"kab\">\n<dc-import name=\"Nav\" part=\"side\" current=\"glavnaya\" suffix=\"-m\" hint-size=\"256px,900px\"></dc-import>\n<dc-import name=\"Nav\" part=\"top\" current=\"glavnaya\" suffix=\"-m\" hint-size=\"100%,56px\"></dc-import>\n<main class=\"kab__main\">\n<section class=\"phead phead--kab\" aria-labelledby=\"pg-h\"><div class=\"wrap\"><div class=\"phead__row\"><div class=\"phead__main\"><h1 id=\"pg-h\">Главная</h1><sc-if value=\"{{ learn }}\" hint-placeholder-val=\"{{ true }}\"><p class=\"lead\">Здравствуйте, Илья. Начните с первого шага.</p></sc-if><sc-if value=\"{{ notLearn }}\" hint-placeholder-val=\"{{ false }}\"><p class=\"lead\">Здравствуйте, Илья. Вот что важно сегодня.</p></sc-if></div><div class=\"phead__acts\"><sc-if value=\"{{ learn }}\" hint-placeholder-val=\"{{ true }}\"><a class=\"btn btn--l\" href=\"klienty-forma-m.dc.html\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg><span>Передать&nbsp;клиента</span></a></sc-if><sc-if value=\"{{ notLearn }}\" hint-placeholder-val=\"{{ false }}\"><a class=\"btn btn--acc btn--l\" id=\"pg-main\" href=\"klienty-forma-m.dc.html\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m22 2-7 20-4-9-9-4Z\"/><path d=\"M22 2 11 13\"/></svg><span>Передать&nbsp;клиента</span></a></sc-if><a class=\"btn btn--l\" href=\"moya-set-m.dc.html\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/></svg><span>Моя&nbsp;сеть</span></a><button type=\"button\" class=\"btn help-q\" aria-label=\"Справка по этому разделу\" title=\"Справка\" onClick=\"{{toggleHelp}}\"><span class=\"help-q__m\" aria-hidden=\"true\">?</span></button></div></div></div></section>\n<sc-if value=\"{{help}}\" hint-placeho