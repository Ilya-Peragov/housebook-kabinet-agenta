lient\">Так ссылку видит клиент</h2><button type=\"button\" class=\"btn btn--icon btn--quiet btn--round x pgx-x\" onClick=\"{{ closeBtn }}\" aria-label=\"Закрыть\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button></div><div class=\"modal__body stack stack--s\"><div class=\"panel panel--sunken stack stack--s\"><h3 class=\"h4\">Housebook: недвижимость за рубежом</h3><p>Клиент видит каталог и форму заявки. Вверху написано, что его консультирует Илья Перагов.</p><div class=\"pgx-row\"><span class=\"badge badge--w badge--muted badge--txt\">Каталог</span><span class=\"badge badge--w badge--muted badge--txt\">Заявка</span></div></div><p class=\"note\">Это пример страницы. Настоящая откроется по ссылке housebook.global/{{ lang }}.</p></div><div class=\"modal__foot\"><button type=\"button\" class=\"btn btn--acc\" onClick=\"{{ closeBtn }}\"><span>Понятно</span></button></div></div></sc-if><sc-if value=\"{{ m_help }}\" hint-placeholder-val=\"{{ false }}\"><div class=\"modal__in\"><div class=\"modal__head\"><h2 id=\"m-help\">Что здесь можно сделать</h2><button type=\"button\" class=\"btn btn--icon btn--quiet btn--round x pgx-x\" onClick=\"{{ closeBtn }}\" aria-label=\"Закрыть\"><svg class=\"ic\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button></div><div class=\"modal__body\"><ul class=\"pgx-help\"><li>Скопируйте ссылку или отправьте её в мессенджер.</li><li>Клиент, перешедший по ссылке, закрепляется за Вами.</li><li>QR-код можно показать клиенту с телефона.</li></ul></div><div class=\"modal__foot\"><button type=\"button\" class=\"btn btn--acc\" onClick=\"{{ closeBtn }}\"><span>Понятно</span></button></div></div></sc-if></div></div></sc-if>\n</main>\n<dc-import name=\"Nav\" part=\"bar\" current=\"ssylka\" suffix=\"-m\" hint-size=\"100%,64px\"></dc-import>\n<dc-import name=\"Nav\" part=\"fab\" current=\"ssylka\" suffix=\"-m\" hint-size=\"1px,1px\"></dc-import>\n<dc-import name=\"Nav\" part=\"cpanel\" current=\"ssylka\" suffix=\"-m\" hint-size=\"1px,1px\"></dc-import>\n</div>\n</div>","script":"\nclass Component extends DCLogic {\n  constructor(props) { super(props); this.state = { lang: 'ru', rulesOpen: false, m: '' }; }\n\n  _y(e) { try { const m = document.querySelector('main.kab__main'); return Math.round(e.currentTarget.getBoundingClientRect().top - m.getBoundingClientRect().top); } catch (x) { return 120; } }\n  say(msg, e) { const y = this._y(e); this.setState({ toast: msg, toastY: Math.max(8, y + ((e && e.currentTarget && e.currentTarget.offsetHeight) || 40) + 8) }); clearTimeout(this._tt); this._tt = setTimeout(() => this.setState({ toast: '' }), 3800); }\n  openM(name, e, extra) { const y = this._y(e); this.setState(Object.assign({ m: name, mTop: Math.max(16, y - 40) }, extra || {})); }\n  closeM() { this.setState({ m: '' }); }\n  baseVals() {\n    const S = this.state;\n    return { toastOn: !!S.toast, toast: S.toast || '', toastStyle: 'top:' + (S.toastY || 80) + 'px;width:max-content;max-width:min(420px,calc(100% - 32px))', mOn: !!S.m, ovlStyle: 'padding-top:' + (S.mTop || 24) + 'px',\n      closeOvl: (e) => { if (e.target === e.currentTarget) this.closeM(); }, closeBtn: () => this.closeM(),\n      helpOpen: (e) => this.openM('help', e), m_help: S.m === 'help' };\n  }\n\n  renderVals() {\n    const S = this.state;\n    return Object.assign(this.baseVals(), { lang: S.lang, isRu: S.lang === 'ru', isEn: S.lang === 'en', setRu: () => this.setState({ lang: 'ru' }), setEn: () => this.setState({ lang: 'en' }),\n      copy: (e) => this.say('Ссылка скопирована', e), sayWa: (e) => this.say('В кабинете откроется WhatsApp со ссылкой', e), sayTg: (e) => this.say('В кабинете откроется Telegram со ссылкой', e), sayMail: (e) => this.say('В кабинете откроется письмо со ссылкой', e),\n      openShare: (e) => this.openM('share', e), openQr: (e) => this.openM('qr', e), openClient: (e) => this.openM('client', e), dlQr: (e) => this.say('QR-код сохранён', e),\n      m_share: S.m === 'share', m_qr: S.m === 'qr', m_client: S.m === 'client', rulesOpen: S.rulesOpen, rulesToggle: () => this.setState({ rulesOpen: !S.rulesOpen }) });\n  }\n}\n\nComponent = (function (Base) { return class extends Base {\n  constructor(props) { super(props);  }\n  renderVals() { const v = super.renderVals(); const S = this.state, set = (o) => this.setState(o); v.lnkAll = HB.isNovice() ? 0 : 5; v.lnkMonth = HB.isNovice() ? 0 : 1; return v; }\n}; })(Component);\n"}